{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 | m0 STLink launch",
            "presentation": {
                "group": "Local"
            },
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceFolder}/build/fw_m0.elf",
            "svdFile": "${workspaceFolder}/platform/m0/core/stm32g431.svd",
            "gdbPath": "${config:gdb_path}",
            "showDevDebugOutput": "raw",
            "servertype": "stlink",
            "interface": "swd"
        },
        {
            "name": "🚀 | m0 STLink attach",
            "presentation": {
                "group": "Local"
            },
            "type": "cortex-debug",
            "request": "attach",
            "executable": "${workspaceFolder}/build/fw_m0.elf",
            "svdFile": "${workspaceFolder}/platform/m0/core/stm32g431.svd",
            "gdbPath": "${config:gdb_path}",
            "showDevDebugOutput": "raw",
            "servertype": "stlink",
            "interface": "swd"
        },
